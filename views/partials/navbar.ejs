<header class="site-header">
    <nav class="navbar" aria-label="Main navigation">
        <a href="/" class="nav-logo">Stayora<span>.</span></a>

        <form class="nav-search" action="/listings" method="GET" role="search">
            <input
                type="search"
                name="city"
                list="stayora-cities"
                autocomplete="off"
                class="nav-search-input"
                placeholder="Search destinations, cities..."
                aria-label="Search destinations or cities"
                <% if ( typeof searchQuery !== 'undefined') { %>
                value="<%= searchQuery %>"
               <% } %> 
            >
            <datalist id="stayora-cities">
                <option value="Agra"></option>
                <option value="Alibaug"></option>
                <option value="Bengaluru"></option>
                <option value="Coorg"></option>
                <option value="Darjeeling"></option>
                <option value="Gangtok"></option>
                <option value="Goa"></option>
                <option value="Hyderabad"></option>
                <option value="Jaipur"></option>
                <option value="Kochi"></option>
                <option value="Leh"></option>
                <option value="Lonavala"></option>
                <option value="Manali"></option>
                <option value="Mumbai"></option>
                <option value="Munnar"></option>
                <option value="Mussoorie"></option>
                <option value="New Delhi"></option>
                <option value="Ooty"></option>
                <option value="Pondicherry"></option>
                <option value="Rishikesh"></option>
                <option value="Shimla"></option>
                <option value="Srinagar"></option>
                <option value="Udaipur"></option>
                <option value="Varanasi"></option>
            </datalist>
            <button type="submit" class="nav-search-btn" aria-label="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </form>

        <button
            type="button"
            class="nav-toggle"
            id="navToggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="navMenu"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-menu" id="navMenu">
            <a href="/listings" class="nav-link">Stays</a>

            <% if (currentUser && currentUser.ROLE === 'admin') { %>
                <a href="/admin/dashboard" class="nav-dashboard-btn">Admin Panel</a>
            <% } else if (currentUser && currentUser.ROLE === 'host') { %>
                <a href="/host/dashboard" class="nav-dashboard-btn">My Dashboard</a>
            <% } else { %>
                <a href="/listings/update/host" class="nav-host-btn">+ Become a Host</a>
            <% } %>

            <% if (currentUser) { %>
                <a href="/authenticate/logout" class="nav-btn nav-btn-outline">Log out</a>
            <% } else { %>
                <a href="/authenticate/login" class="nav-link">Log in</a>
                <a href="/authenticate/signup" class="nav-btn nav-btn-primary">Sign up</a>
            <% } %>
        </div>
    </nav>
</header>
