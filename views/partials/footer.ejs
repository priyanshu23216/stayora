<footer class="footer" aria-label="Stayora Directory">
    <div class="footer-shell">

        <!-- 5-Column Apple Directory -->
        <nav class="footer-directory" aria-label="Footer navigation">

            <!-- Column 1: Explore & Categories -->
            <div class="footer-col">
                <div class="footer-section">
                    <h3 class="footer-heading">Explore Stays</h3>
                    <ul class="footer-list">
                        <li><a href="/listings">All Properties</a></li>
                        <li><a href="/listings?type=hotel">Hotels</a></li>
                        <li><a href="/listings?type=resort">Resorts</a></li>
                        <li><a href="/listings?type=villa">Villas</a></li>
                        <li><a href="/listings?type=apartment">Apartments</a></li>
                        <li><a href="/listings?type=guesthouse">Guesthouses</a></li>
                        <li><a href="/listings?type=hostel">Hostels</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-heading">Discover</h3>
                    <ul class="footer-list">
                        <li><a href="/categories">Categories</a></li>
                        <li><a href="/destinations">Popular Destinations</a></li>
                    </ul>
                </div>
            </div>

            <!-- Column 2: Destinations -->
            <div class="footer-col">
                <div class="footer-section">
                    <h3 class="footer-heading">Top Destinations</h3>
                    <ul class="footer-list">
                        <li><a href="/listings?city=Goa">Goa</a></li>
                        <li><a href="/listings?city=Udaipur">Udaipur</a></li>
                        <li><a href="/listings?city=Jaipur">Jaipur</a></li>
                        <li><a href="/listings?city=Manali">Manali</a></li>
                        <li><a href="/listings?city=Mumbai">Mumbai</a></li>
                        <li><a href="/listings?city=Bengaluru">Bengaluru</a></li>
                        <li><a href="/listings?city=Rishikesh">Rishikesh</a></li>
                        <li><a href="/listings?city=Shimla">Shimla</a></li>
                    </ul>
                </div>
            </div>

            <!-- Column 3: Account & Collections -->
            <div class="footer-col">
                <div class="footer-section">
                    <h3 class="footer-heading">Account</h3>
                    <ul class="footer-list">
                        <% if (currentUser) { %>
                            <% if (currentUser.ROLE !== 'admin') { %>
                                <li><a href="/guest/dashboard">My Bookings</a></li>
                            <% } %>
                            <% if (currentUser.ROLE === 'host') { %>
                                <li><a href="/host/dashboard">Host Dashboard</a></li>
                            <% } else if (currentUser.ROLE === 'admin') { %>
                                <li><a href="/admin/dashboard">Admin Panel</a></li>
                            <% } %>
                        <% } else { %>
                            <li><a href="/authenticate/login">Log in</a></li>
                            <li><a href="/authenticate/signup">Create Account</a></li>
                            <li><a href="/authenticate/forgot-password">Reset Password</a></li>
                        <% } %>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-heading">By Budget &amp; Rating</h3>
                    <ul class="footer-list">
                        <li><a href="/listings?sort=Top+Rated">Top Rated Stays</a></li>
                        <li><a href="/listings?price=under_3000">Under &#8377;3,000</a></li>
                        <li><a href="/listings?price=5000_10000">&#8377;5,000 &ndash; &#8377;10,000</a></li>
                        <li><a href="/listings?price=above_20000">Luxury Stays</a></li>
                    </ul>
                </div>
            </div>

            <!-- Column 4: Hosting -->
            <div class="footer-col">
                <div class="footer-section">
                    <h3 class="footer-heading">For Hosts</h3>
                    <ul class="footer-list">
                        <li>
                            <% if (currentUser && currentUser.ROLE === 'host') { %>
                                <a href="/host/dashboard">List Your Property</a>
                            <% } else if (currentUser && currentUser.ROLE !== 'admin') { %>
                                <form action="/listings/update/host" method="POST" class="footer-inline-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="footer-link-btn">List Your Property</button>
                                </form>
                            <% } else { %>
                                <a href="/listings/update/host">List Your Property</a>
                            <% } %>
                        </li>
                        <li><a href="/help#hosting-guide">Hosting Guide</a></li>
                        <% if (currentUser && currentUser.ROLE === 'host') { %>
                            <li><a href="/host/bookings">Guest Bookings</a></li>
                        <% } %>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-heading">Trust &amp; Standards</h3>
                    <ul class="footer-list">
                        <li><a href="/about">Verified Properties</a></li>
                        <li><a href="/help">Cancellation Policies</a></li>
                        <li><a href="/privacy">Data Protection</a></li>
                    </ul>
                </div>
            </div>

            <!-- Column 5: About & Connect -->
            <div class="footer-col">
                <div class="footer-section">
                    <h3 class="footer-heading">About Stayora</h3>
                    <ul class="footer-list">
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/help">Help Centre</a></li>
                        <li><a href="/contact">Contact Us</a></li>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms &amp; Conditions</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3 class="footer-heading">Connect</h3>
                    <ul class="footer-list">
                        <li><a href="https://www.linkedin.com/in/priyanshu-singh-97a4782ab" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                        <li><a href="https://github.com/priyanshu23216" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                    </ul>
                </div>
            </div>

        </nav>

        <!-- Apple-Style Utility Line -->
        <div class="footer-more-ways">
            More ways to stay: <a href="/listings">Explore all stays</a>, browse <a href="/destinations">popular destinations</a>, or visit the <a href="/help">Stayora Help Centre</a>.
        </div>

        <!-- Apple-Style Bottom Legal Bar -->
        <div class="footer-legal">
            <div class="footer-legal-left">
                <p class="footer-copyright">
                    Copyright &copy; <%= new Date().getFullYear() %> Stayora Inc. All rights reserved.
                </p>

                <ul class="footer-legal-links">
                    <li><a href="/privacy">Privacy Policy</a></li>
                    <li><a href="/terms">Terms of Use</a></li>
                    <li><a href="/help">Help Centre</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </div>

            <div class="footer-locale">
                <span>India (English)</span>
            </div>
        </div>

    </div>
</footer>
