<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stayora <%= title %></title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/listings.css">
    <link rel="stylesheet" href="/css/show.css">
    <link rel="stylesheet" href="/css/pages.css">
    <link rel="stylesheet" href="/css/booking.css">
    <link rel="stylesheet" href="/css/host.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/guest.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
    <!-- Shared SVG Optical Refraction Filter for Apple Liquid Glass -->
    <svg class="liquid-glass-defs" aria-hidden="true" focusable="false">
        <defs>
            <filter id="liquid-glass-lens" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
                <feTurbulence type="fractalNoise" baseFrequency="0.008 0.014" numOctaves="2" seed="7" result="noise" />
                <feGaussianBlur in="noise" stdDeviation="2.5" result="smoothNoise" />
                <feDisplacementMap in="SourceGraphic" in2="smoothNoise" scale="18" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </defs>
    </svg>

    <%- include('../partials/navbar.ejs') %>

    <% if ((jarvis && jarvis.length > 0) || (success && success.length > 0) || (error && error.length > 0)) { %>
        <div class="flash-stack" aria-live="polite">
            <% if (jarvis && jarvis.length > 0) { %>
                <div class="flash-toast flash-jarvis" role="status">
                    <span class="jarvis-corner jarvis-tl" aria-hidden="true"></span>
                    <span class="jarvis-corner jarvis-tr" aria-hidden="true"></span>
                    <span class="jarvis-corner jarvis-bl" aria-hidden="true"></span>
                    <span class="jarvis-corner jarvis-br" aria-hidden="true"></span>
                    <span class="jarvis-scan" aria-hidden="true"></span>

                    <span class="jarvis-reactor" aria-hidden="true">
                        <svg viewBox="0 0 40 40" fill="none">
                            <circle cx="20" cy="20" r="17" stroke="#38bdf8" stroke-opacity="0.38" stroke-width="1.2" stroke-dasharray="6 4" class="jarvis-ring-cw"></circle>
                            <circle cx="20" cy="20" r="12" stroke="#7dd3fc" stroke-width="1.6" stroke-dasharray="14 6" class="jarvis-ring-ccw"></circle>
                            <circle cx="20" cy="20" r="5" fill="#38bdf8" fill-opacity="0.28" stroke="#38bdf8" stroke-width="1.5"></circle>
                            <circle cx="20" cy="20" r="2" fill="#e0f2fe"></circle>
                        </svg>
                    </span>

                    <div class="jarvis-body">
                        <span class="jarvis-eyebrow">STAYORA.OS // AUTH VERIFIED</span>
                        <span class="jarvis-message"><%= jarvis %></span>
                    </div>

                    <button type="button" class="flash-close jarvis-close" aria-label="Dismiss notification">[&times;]</button>
                    <span class="jarvis-progress" aria-hidden="true"></span>
                </div>
            <% } %>

            <% if (success && success.length > 0) { %>
                <div class="flash-toast flash-success" role="status">
                    <span class="flash-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </span>
                    <span class="flash-text"><%= success %></span>
                    <button type="button" class="flash-close" aria-label="Dismiss notification">&times;</button>
                </div>
            <% } %>

            <% if (error && error.length > 0) { %>
                <div class="flash-toast flash-error" role="alert">
                    <span class="flash-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </span>
                    <span class="flash-text"><%= error %></span>
                    <button type="button" class="flash-close" aria-label="Dismiss notification">&times;</button>
                </div>
            <% } %>
        </div>
    <% } %>
    
        <%- body %>

    <%- include('../partials/footer.ejs') %>
    <script src="/js/navbar.js" defer></script>
</body>
</html>