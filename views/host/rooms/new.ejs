<section class="host-page host-form-page">
    <div class="host-breadcrumb">
        <a href="/host/listings/<%= property.ID %>" class="host-back-link">&larr; Back to <%= property.title %></a>
    </div>

    <header class="host-header host-header-stack">
        <div class="host-header-text">
            <span class="host-eyebrow">Add Room</span>
            <h1 class="host-title">New Room Type</h1>
            <p class="host-subtitle">Add a room type under <strong><%= property.title %></strong> with pricing, capacity, photos, and room amenities.</p>
        </div>
    </header>

    <form
        action="/host/listings/<%= property.ID %>/rooms"
        method="POST"
        enctype="multipart/form-data"
        class="host-form"
        id="roomForm"
    >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- 1. Room Details -->
        <div class="host-card">
            <h2 class="host-card-title">Room Details</h2>

            <div class="host-field-grid">
                <div class="host-field host-field-full">
                    <label for="roomType">Room Name</label>
                    <input
                        type="text"
                        id="roomType"
                        name="roomType"
                        placeholder="e.g. Deluxe King Room"
                        minlength="3"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="host-field">
                    <label for="pricePerNight">Price per Night (&#8377;)</label>
                    <input
                        type="number"
                        id="pricePerNight"
                        name="pricePerNight"
                        min="100"
                        step="50"
                        placeholder="e.g. 5500"
                        required
                    >
                </div>

                <div class="host-field">
                    <label for="capacity">Max Guests per Room</label>
                    <input
                        type="number"
                        id="capacity"
                        name="capacity"
                        min="1"
                        max="20"
                        value="2"
                        required
                    >
                </div>

                <div class="host-field host-field-full">
                    <label for="totalRooms">Number of Rooms of This Type</label>
                    <input
                        type="number"
                        id="totalRooms"
                        name="totalRooms"
                        min="1"
                        max="200"
                        value="1"
                        required
                    >
                </div>

                <div class="host-field host-field-full">
                    <label for="description">Room Description</label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        minlength="10"
                        placeholder="Describe bed type, view, layout, and what guests can expect in this room..."
                        required
                    ></textarea>
                </div>
            </div>
        </div>

        <!-- 2. Room Photos -->
        <div class="host-card">
            <h2 class="host-card-title">Room Photos</h2>
            <p class="host-card-hint">Upload up to 4 room photos (JPEG, PNG, WEBP, or AVIF, max 5 MB each).</p>

            <div class="host-field-grid">
                <div class="host-field host-field-full">
                    <label for="roomImages">Room Images <span class="host-optional">(Optional, up to 4)</span></label>
                    <input
                        type="file"
                        id="roomImages"
                        name="roomImages"
                        accept="image/jpeg,image/png,image/webp,image/avif"
                        class="host-file-input"
                        multiple
                    >
                    <div id="roomPreview" class="host-preview-grid" aria-live="polite"></div>
                </div>
            </div>
        </div>

        <!-- 3. Room Amenities -->
        <% if (amenities && amenities.length > 0) { %>
            <div class="host-card">
                <h2 class="host-card-title">Room Amenities</h2>
                <p class="host-card-hint">Select all amenities included inside this room.</p>

                <div class="host-amenities-grid">
                    <% for (let amenity of amenities) { %>
                        <label class="host-amenity-chip">
                            <input type="checkbox" name="amenities" value="<%= amenity.ID %>">
                            <span><%= amenity.NAME %></span>
                        </label>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Submit Actions -->
        <div class="host-form-actions">
            <a href="/host/listings/<%= property.ID %>" class="host-cancel-btn">Cancel</a>
            <button type="submit" class="host-submit-btn" id="submitRoomBtn">Add Room</button>
        </div>
    </form>
</section>

<script src="/js/hostRoomForm.js" defer></script>
