<section class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Verification</h1>
        </div>

        <div class="auth-body">
            <h2 class="auth-title">Verify your email</h2>
            <p class="auth-subtitle">
                Enter the six-digit code sent to <strong><%= email %></strong>.
            </p>

            <form class="auth-form" action="/authenticate/signup/verify-otp" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="email" value="<%= email %>">

                <div class="auth-field">
                    <label for="otp">Verification code</label>
                    <input
                        id="otp"
                        name="otp"
                        type="text"
                        class="auth-otp-input"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        placeholder="000000"
                        pattern="[0-9]{6}"
                        minlength="6"
                        maxlength="6"
                        required
                    >
                </div>

                <button type="submit" class="auth-submit">Verify email</button>
            </form>

            <form class="auth-resend-form" action="/authenticate/signup/resend-otp" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="email" value="<%= email %>">
                <p id="resend-countdown-message" class="auth-countdown">
                    You can request another code in <span id="resend-countdown">60</span> seconds.
                </p>
                <button id="resend-otp-button" type="submit" class="auth-btn-secondary" hidden>
                    Resend code
                </button>
            </form>
        </div>
    </div>
</section>

<!-- External JS file for resend countdown to comply with CSP -->
<script src="/js/resendOTP.js" defer></script>
