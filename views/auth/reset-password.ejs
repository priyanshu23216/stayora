<section class="otp-screen" aria-label="Reset password">
    <!-- Minimal Apple-style Top Bar -->
    <header class="otp-topbar">
        <a href="/" class="otp-brand"><%- include('../partials/brand-mark.ejs') %>Stayora</a>
        <a href="/authenticate/login" class="otp-back-link">&larr; Back to Log in</a>
    </header>

    <!-- Centered Full-Screen Reset Password Card -->
    <main class="otp-main">
        <div class="otp-card">
            <div class="otp-icon-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </div>

            <h1 class="otp-title">Set a new password</h1>
            <p class="otp-subtitle">
                Use at least 8 characters with uppercase, lowercase, a number, and a special character.
            </p>

            <form class="auth-form otp-form-stack" action="/authenticate/reset-password/<%= token %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="otp-field">
                    <label for="password">New password</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        maxlength="255"
                        placeholder="Enter a strong password"
                        autocomplete="new-password"
                        autofocus
                        required
                    >
                    <span class="error-password auth-error"></span>
                </div>

                <button type="submit" class="otp-submit-btn">Reset Password</button>
            </form>

            <p class="otp-card-footer">
                Remembered your password? <a href="/authenticate/login">Log in</a>
            </p>
        </div>

        <p class="otp-footnote">
            All other active sessions will be signed out automatically
        </p>
    </main>
</section>

<script src="/js/resetPassValidate.js" defer></script>
