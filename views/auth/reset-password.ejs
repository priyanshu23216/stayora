<section class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Reset password</h1>
        </div>

        <div class="auth-body">
            <h2 class="auth-title">Set a new password</h2>
            <p class="auth-subtitle">
                Choose a strong password with at least 8 characters, including an uppercase letter, lowercase letter, number, and special character.
            </p>

            <form class="auth-form" action="/authenticate/reset-password/<%= token %>" method="POST">
                <div class="auth-field">
                    <label for="password">New password</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        maxlength="255"
                        placeholder="Enter a strong password"
                        autocomplete="new-password"
                        required
                    >
                    <span class="error-password auth-error"></span>
                </div>

                <button type="submit" class="auth-submit">Reset Password</button>
            </form>

            <p class="auth-footer">
                Remembered your password? <a href="/authenticate/login">Back to Log in</a>
            </p>
        </div>
    </div>
</section>
