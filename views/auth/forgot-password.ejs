<section class="otp-screen" aria-label="Forgot password">
    <!-- Minimal Apple-style Top Bar -->
    <header class="otp-topbar">
        <a href="/" class="otp-brand"><%- include('../partials/brand-mark.ejs') %>Stayora</a>
        <a href="/authenticate/login" class="otp-back-link">&larr; Back to Log in</a>
    </header>

    <!-- Centered Full-Screen Forgot Password Card -->
    <main class="otp-main">
        <div class="otp-card">
            <div class="otp-icon-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="11" width="16" height="10" rx="3"></rect>
                    <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
                    <circle cx="12" cy="16" r="1"></circle>
                </svg>
            </div>

            <h1 class="otp-title">Reset your password</h1>
            <p class="otp-subtitle">
                Enter the email address associated with your Stayora account and we&rsquo;ll send you a reset link.
            </p>

            <form class="otp-form-stack" action="/authenticate/forgot-password/submit" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="otp-field">
                    <label for="email">Email address</label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        autofocus
                        required
                    >
                </div>

                <button type="submit" class="otp-submit-btn">Send Reset Link</button>
            </form>

            <p class="otp-card-footer">
                Remembered your password? <a href="/authenticate/login">Log in</a>
            </p>
        </div>

        <p class="otp-footnote">
            Reset link expires in 10 minutes &middot; Protected by Stayora Security
        </p>
    </main>
</section>
