<h1>Set a New Password</h1>

<form action="/authenticate/reset-password/<%= token %>" method="POST">
	<div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" maxlength="255" placeholder = "Enter Strong Password " required>
        <span class="error-password" style="color: #e53e3e; display: block; margin-top: 5px; font-size: 13px;"></span>
    </div>
	<button type="submit">Reset Password</button>
</form>