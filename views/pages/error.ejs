<section class="info-page" style="text-align: center; padding: 72px 20px;">
    <header class="info-hero">
        <span class="info-eyebrow">Error <%= statusCode %></span>
        <h1 class="info-title"><%= heading %></h1>
        <p class="info-subtitle"><%= message %></p>
    </header>

    <div style="margin-top: 28px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="info-btn">Back to Home</a>
        <a href="/listings" class="info-btn" style="background: #1d1d1f;">Explore Stays</a>
    </div>
</section>
