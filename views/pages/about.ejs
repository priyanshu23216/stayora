<div class="info-page apple-doc-page">

    <!-- Apple Editorial Hero -->
    <header class="info-hero apple-doc-hero">
        <div class="apple-hero-icon" aria-hidden="true">
            <%- include('../partials/brand-mark.ejs') %>
        </div>
        <span class="info-eyebrow"><%- include('../partials/brand-mark.ejs') %>About Stayora</span>
        <h1 class="info-title">Thoughtful stays, built for effortless travel.</h1>
        <p class="info-subtitle">
            Stayora connects travellers with curated hotels, villas, resorts, and homestays across India - with transparent pricing and verified hosts.
        </p>
    </header>

    <!-- Apple Key Highlights Strip -->
    <section class="apple-stats-strip" aria-label="Stayora highlights">
        <div class="apple-stat-tile">
            <span class="apple-stat-num">100%</span>
            <span class="apple-stat-label">Admin-Verified Listings</span>
        </div>
        <div class="apple-stat-tile">
            <span class="apple-stat-num">&#8377;0</span>
            <span class="apple-stat-label">Hidden Platform Fees</span>
        </div>
        <div class="apple-stat-tile">
            <span class="apple-stat-num">24+</span>
            <span class="apple-stat-label">Curated Indian Cities</span>
        </div>
    </section>

    <!-- Our Vision Editorial Card -->
    <section class="info-card-white apple-vision-card">
        <span class="apple-section-kicker">Our Vision</span>
        <h2 class="info-section-title">Travel planning should feel as calm as the stay itself.</h2>
        <p class="info-text">
            We believe finding a great place to stay should feel calm, clear, and trustworthy. No hidden surprises, no cluttered interfaces - just verified properties, honest guest reviews, and rooms tailored to how you travel.
        </p>
        <p class="info-text">
            Whether you are planning a quiet mountain retreat, a coastal villa weekend, or a quick city stopover, Stayora is designed to help you discover spaces that feel memorable from check-in to check-out.
        </p>
    </section>

    <!-- 3 Apple Values Cards -->
    <section class="info-grid-3" aria-label="Stayora values">
        <div class="feature-tile apple-value-card">
            <span class="apple-tile-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </span>
            <h3>Verified Properties</h3>
            <p>Every listing goes through a careful verification process before appearing on Stayora so you can book with complete confidence.</p>
        </div>
        <div class="feature-tile apple-value-card">
            <span class="apple-tile-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 4h12"></path>
                    <path d="M6 9h12"></path>
                    <path d="m6 14 8.5 7"></path>
                    <path d="M6 14h3a5 5 0 0 0 0-10"></path>
                </svg>
            </span>
            <h3>Transparent Pricing</h3>
            <p>Clear per-night room rates, exact guest capacities, and upfront cancellation policies with zero last-minute guesswork.</p>
        </div>
        <div class="feature-tile apple-value-card">
            <span class="apple-tile-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10.5 12 3l9 7.5"></path>
                    <path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"></path>
                    <path d="M9.5 21v-6h5v6"></path>
                </svg>
            </span>
            <h3>Built for Hosts &amp; Guests</h3>
            <p>Thoughtful tools for property owners to showcase their rooms and for guests to discover the right stay effortlessly.</p>
        </div>
    </section>

    <!-- Apple Pro Dark Founder Showcase -->
    <section class="founder-card apple-founder-card">
        <div class="founder-avatar" aria-hidden="true">PS</div>
        <div class="founder-content">
            <span class="founder-role">Founder &amp; CEO</span>
            <h2 class="founder-name">Priyanshu Singh</h2>
            <p class="founder-quote">
                &ldquo;Stayora started with a simple idea: travel planning should feel as relaxing as the trip itself. Our focus is on building a clean, reliable platform where great hosts and curious travellers connect effortlessly.&rdquo;
            </p>
            <div class="founder-links">
                <a href="https://www.linkedin.com/in/priyanshu-singh-97a4782ab" target="_blank" rel="noopener noreferrer" class="founder-social-pill">LinkedIn &rarr;</a>
                <a href="https://github.com/priyanshu23216" target="_blank" rel="noopener noreferrer" class="founder-social-pill">GitHub &rarr;</a>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="info-cta-bar apple-support-cta">
        <span class="apple-section-kicker">Start Exploring</span>
        <h2>Ready for your next stay?</h2>
        <p>Explore verified hotels, villas, and retreats across India&rsquo;s favourite destinations.</p>
        <div class="apple-cta-actions">
            <a href="/listings" class="info-btn">Explore Stays</a>
            <a href="/destinations" class="apple-btn-soft">Popular Destinations</a>
        </div>
    </section>

</div>
