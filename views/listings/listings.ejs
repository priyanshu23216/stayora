<!-- 1. Filter Bar -->
<section class="listings-filters">
    <form action="/listings" method="GET" class="filter-form">
        <% if (locals.searchQuery) { %>
            <input type="hidden" name="city" value="<%= locals.searchQuery %>">
        <% } %>

        <div class="filter-group">
            <label for="type">Property Type</label>
            <select name="type" id="type">
                <option value="All Types" <%= (!locals.type || locals.type === 'All Types') ? 'selected' : '' %>>All Types</option>
                <option value="hotel" <%= locals.type === 'hotel' ? 'selected' : '' %>>Hotel</option>
                <option value="resort" <%= locals.type === 'resort' ? 'selected' : '' %>>Resort</option>
                <option value="villa" <%= locals.type === 'villa' ? 'selected' : '' %>>Villa</option>
                <option value="apartment" <%= locals.type === 'apartment' ? 'selected' : '' %>>Apartment</option>
                <option value="guesthouse" <%= locals.type === 'guesthouse' ? 'selected' : '' %>>Guesthouse</option>
                <option value="hostel" <%= locals.type === 'hostel' ? 'selected' : '' %>>Hostel</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="price">Price</label>
            <select name="price" id="price">
                <option value="Any Price" <%= (!locals.price || locals.price === 'Any Price') ? 'selected' : '' %>>Any Price</option>
                <option value="under_3000" <%= locals.price === 'under_3000' ? 'selected' : '' %>>Under ₹3,000</option>
                <option value="3000_5000" <%= locals.price === '3000_5000' ? 'selected' : '' %>>₹3,000 - ₹5,000</option>
                <option value="5000_10000" <%= locals.price === '5000_10000' ? 'selected' : '' %>>₹5,000 - ₹10,000</option>
                <option value="10000_20000" <%= locals.price === '10000_20000' ? 'selected' : '' %>>₹10,000 - ₹20,000</option>
                <option value="above_20000" <%= locals.price === 'above_20000' ? 'selected' : '' %>>₹20,000+</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="sort">Sort By</label>
            <select name="sort" id="sort">
                <option value="Low to High" <%= (!locals.sort || locals.sort === 'Low to High') ? 'selected' : '' %>>Price: Low to High</option>
                <option value="High to Low" <%= locals.sort === 'High to Low' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="Top Rated" <%= locals.sort === 'Top Rated' ? 'selected' : '' %>>Top Rated</option>
            </select>
        </div>

        <button type="submit" class="filter-btn">Apply</button>
        <a href="/listings" class="filter-reset">Reset</a>
    </form>
</section>

<!-- 2. Properties Cards -->
<section class="listings-section">
    <% if (listings.length === 0) { %>
        <div class="no-listings">
            <h2>No stays found</h2>
            <p>Try searching another city or clearing your filters.</p>
            <a href="/listings" class="view-more-btn">Show All Stays</a>
        </div>
    <% } else { %>
        <div class="listings-grid">
            <% for (let item of listings) { %>
                <div class="listing-card">
                    <div class="listing-img-box">
                        <img src="<%= item.image %>" alt="<%= item.title %>" class="listing-img">
                        <span class="listing-type"><%= item.PROPERTY_TYPE %></span>
                    </div>

                    <div class="listing-info">
                        <h3 class="listing-title"><%= item.title %></h3>
                        <p class="listing-location"><%= item.city %>, <%= item.state %></p>
                        <p class="listing-price">From ₹<%= item.price_per_night %> <span>/ night</span></p>
                        <a href="/listings/<%= item.ID %>" class="view-more-btn">View More</a>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</section>

<!-- 3. Pagination Buttons (URL-encoded query params) -->
<%
    const buildPageUrl = (targetPage) => {
        const params = new URLSearchParams();
        if (locals.searchQuery) params.set("city", locals.searchQuery);
        if (locals.type) params.set("type", locals.type);
        if (locals.price) params.set("price", locals.price);
        if (locals.sort) params.set("sort", locals.sort);
        params.set("page", String(targetPage));
        return `/listings?${params.toString()}`;
    };
%>
<nav class="pagination" aria-label="Listings pagination">
    <% if (currentPage > 1) { %>
        <a href="<%= buildPageUrl(currentPage - 1) %>" class="pagination-btn">&larr; Previous</a>
    <% } %>

    <span class="pagination-info">Page <%= currentPage %> of <%= totalPages %></span>

    <% if (currentPage < totalPages) { %>
        <a href="<%= buildPageUrl(currentPage + 1) %>" class="pagination-btn">Next &rarr;</a>
    <% } %>
</nav>
