# Your application will run on this port on localhost
PORT=8080

# Default is development; change to production only when deploying the application
NODE_ENV=development

# Set to 1 when deployed behind a reverse proxy (Nginx, Cloudflare, Render, Railway)
TRUST_PROXY=0

# Base URL used for generating password reset links
APP_URL=http://localhost:8080

# Session secret key (minimum 16 characters) for sending signed session cookies to browser
SESSION_SECRET=your_super_secret_session_key_min_16_chars

# Optional founder email for custom welcome toast
FOUNDER_EMAIL=

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=STAYORA

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/authenticate/google/callback

# Resend Transactional Email API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Stayora <noreply@bookstayora.in>
SUPPORT_EMAIL=support@bookstayora.in

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
